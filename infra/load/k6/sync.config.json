{
  "multiplier": 3,
  "base_urls": {
    "admin": "http://127.0.0.1:3002"
  },
  "requests": {
    "sync": {
      "platform": "pdd",
      "order_nos": ["local-load-order-1"]
    }
  },
  "scenarios": {
