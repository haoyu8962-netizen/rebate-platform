[
  {
    "name": "ok：合法 code 与 state",
    "url": "couli://auth/taobao?code=wc_4b8d1e6a&state=st_7f3a9c2e",
    "expect": {
      "kind": "ok",
      "code": "wc_4b8d1e6a",
      "state": "st_7f3a9c2e"
    }
  },
  {
    "name": "ok：键顺序不同（state 在前）",
    "url": "couli://auth/taobao?state=st_7f3a9c2e&code=wc_4b8d1e6a",
    "expect": {
      "kind": "ok",
      "code": "wc_4b8d1e6a",
      "state": "st_7f3a9c2e"
    }
  },
  {
    "name": "ok：百分号编码按解码后的值返回",
