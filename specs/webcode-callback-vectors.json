    "expect": {
      "kind": "ok",
      "code": "wc_4b8d1e6a",
      "state": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss"
    }
  },
  {
    "name": "ok：code 恰 4096 字符（上界）",
    "url": "couli://auth/taobao?&state=st_7f3a9c2e",
    "expect": {
      "kind": "ok",
      "code": "",
      "state": "st_7f3a9c2e"
    }
  },
  {
    "name": "ok：code 与 state 均为 1 字符（下界）",
    "url": "couli://auth/taobao?code=c&state=s",
