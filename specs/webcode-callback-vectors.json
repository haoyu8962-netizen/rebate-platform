    "expect": {
      "kind": "ok",
      "code": "wc/a+b=",
      "state": "st-1"
    }
  },
  {
    "name": "ok：额外键忽略，只取 code 与 state",
    "url": "couli://auth/taobao?code=wc_4b8d1e6a&state=st_7f3a9c2e&spm=a21bo.1&from=tb",
    "expect": {
      "kind": "ok",
      "code": "wc_4b8d1e6a",
      "state": "st_7f3a9c2e"
    }
  },
  {
    "name": "ok：state 恰 128 字符（上界）",
